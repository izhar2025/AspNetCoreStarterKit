# .env.example
# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is git-ignored - it's meant to hold secrets for your local machine only,
# never commit it.
#
#   cp .env.example .env

# --- SQL Server ---
# Must satisfy SQL Server's complexity rules: 8+ chars, upper+lower+digit+symbol.
SA_PASSWORD=YourStr0ng!Passw0rd

# --- JWT ---
# Minimum 32 characters. Generate one with: openssl rand -base64 32
JWT_KEY=change-this-to-a-random-secret-at-least-32-characters-long
JWT_ISSUER=AspNetCoreStarterKit
JWT_AUDIENCE=AspNetCoreStarterKitClient

# --- Email (SMTP) - used for password reset emails ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=AspNetCoreStarterKit

# --- App ---
# The frontend URL that password-reset emails link to.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
