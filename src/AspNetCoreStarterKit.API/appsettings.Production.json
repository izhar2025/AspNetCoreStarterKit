{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_PRODUCTION_SERVER;Database=YourProjectDb;User Id=YOUR_USER;Password=YOUR_STRONG_PASSWORD;TrustServerCertificate=false;Encrypt=true;MultipleActiveResultSets=true;"
  },
  "Jwt": {
    "Key": "PRODUCTION-SUPER-SECRET-KEY-MINIMUM-32-CHARACTERS!",
    "Issuer": "YourProject",
    "Audience": "YourProjectClient",
    "AccessTokenExpiryMinutes": "15",
    "RefreshTokenExpiryDays": "7"
  },
  "FileStorage": {
    "LocalPath": "D:\\Uploads\\YourProject",
    "MaxFileSize": 52428800,
    "AllowedExtensions": ".jpg,.jpeg,.png,.pdf,.doc,.docx"
  },
  "Email": {
    "SmtpHost": "smtp.office365.com",
    "SmtpPort": 587,
    "SmtpUser": "noreply@yourcompany.com",
    "SmtpPass": "PRODUCTION_EMAIL_PASSWORD",
    "FromEmail": "noreply@yourcompany.com",
    "FromName": "YourProject System"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Error"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://yourdomain.com",
      "https://www.yourdomain.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}